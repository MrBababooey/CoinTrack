# Copy this file to .env and fill in your values.

# --- Spot price API -------------------------------------------------------
# One of: metalsdev | metalpriceapi | goldapi | manual
#   metalsdev     https://metals.dev          (free tier: 100 requests/month)
#   metalpriceapi https://metalpriceapi.com   (free tier: 100 requests/month)
#   goldapi       https://www.goldapi.io      (free tier: 100 requests/month; 4 requests per refresh)
#   manual        no API; enter spot prices on the Spot prices page
PRICE_PROVIDER=metalsdev
PRICE_API_KEY=

# Currency for all prices (ISO code supported by your provider).
CURRENCY=USD

# Hours between automatic spot price refreshes. 12h ≈ 60 requests/month.
# With goldapi use 24 or more (each refresh costs 4 requests).
REFRESH_HOURS=12

# Minimum minutes between manual "Refresh prices" clicks.
MIN_REFRESH_MINUTES=10

# Collectible market values older than this many days are flagged for update.
STALE_DAYS=90

# --- Server ---------------------------------------------------------------
# 127.0.0.1 = this computer only. Use 0.0.0.0 to reach it from other devices
# on your network (there is no login, so only do that on a trusted network).
HOST=127.0.0.1
PORT=3000
DB_PATH=data/cointrack.db
